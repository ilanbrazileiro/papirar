[
  {
    "name": "createCorporation",
    "title": "Criar corporação",
    "description": "Cria uma corporação no catálogo do Papirar.",
    "method": "POST",
    "path": "/catalog/corporations",
    "controller": "CatalogCourseApiController",
    "action": "storeCorporation",
    "read_only": false,
    "roles": ["admin"],
    "schema": {"type":"object","properties":{"name":{"type":"string","minLength":2},"slug":{"type":"string"},"description":{"type":"string"},"active":{"type":"boolean"}},"required":["name"]}
  },
  {
    "name": "updateCorporation",
    "title": "Atualizar corporação",
    "description": "Atualiza dados textuais de uma corporação existente.",
    "method": "PATCH",
    "path": "/catalog/corporations/{corporation}",
    "controller": "CatalogCourseApiController",
    "action": "updateCorporation",
    "read_only": false,
    "roles": ["admin"],
    "bindings": {"corporation":{"argument":"corporation","model":"App\\Models\\Corporation"}},
    "schema": {"type":"object","properties":{"corporation":{"type":"integer","minimum":1},"name":{"type":"string","minLength":2},"slug":{"type":"string"},"description":{"type":"string"}},"required":["corporation"]}
  },
  {
