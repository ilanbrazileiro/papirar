  {
    "name": "searchQuestions",
    "title": "Pesquisa questões",
    "description": "Pesquisa questões existentes com filtros.",
    "method": "GET",
    "path": "/questions",
    "controller": "QuestionReviewApiController",
    "action": "questions",
    "read_only": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corporation_id": {
          "type": "integer"
        },
        "exam_id": {
          "type": "integer"
        },
        "exam_board_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "topic_id": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "reviewed",
            "archived"
          ]
        },
        "source_type": {
          "type": "string",
          "enum": [
            "exam",
            "authored",
            "adapted"
          ]
        },
        "q": {
          "type": "string"
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    }
  },
  {
    "name": "createDraftQuestion",
    "title": "Cria uma questão",
    "description": "Para uma questão. Para duas ou mais use batch.",
    "method": "POST",
    "path": "/questions",
    "controller": "QuestionWriteApiController",
    "action": "store",
    "read_only": false,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "topic_id",
        "statement",
        "question_type",
        "difficulty",
        "source_type",
        "correct_letter",
        "alternatives"
      ],
      "properties": {
        "corporation_id": {
          "type": "integer"
        },
        "exam_id": {
          "type": "integer"
        },
        "exam_board_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "topic_id": {
          "type": "integer"
        },
        "source_material_id": {
          "type": "integer"
        },
        "statement": {
          "type": "string",
          "minLength": 5
        },
        "question_type": {
          "type": "string",
          "description": "Normalmente multiple_choice."
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "source_type": {
          "type": "string",
          "enum": [
            "exam",
            "authored",
            "adapted"
          ]
        },
        "source_reference": {
          "type": "string"
        },
        "commented_answer": {
          "type": "string"
        },
        "correct_letter": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "allow_duplicate": {
          "type": "boolean",
          "default": false
        },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "letter",
              "text"
            ],
            "properties": {
              "letter": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "createDraftQuestionsBatch",
    "title": "Cadastra lote",
    "description": "Use para 2 a 20 questões. Cada item é isolado.",
    "method": "POST",
    "path": "/questions/batch",
    "controller": "QuestionBatchWriteApiController",
    "action": "store",
    "read_only": false,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject_id",
              "topic_id",
              "statement",
              "question_type",
              "difficulty",
              "source_type",
              "correct_letter",
              "alternatives"
            ],
            "properties": {
              "corporation_id": {
                "type": "integer"
              },
              "exam_id": {
                "type": "integer"
              },
              "exam_board_id": {
                "type": "integer"
              },
              "subject_id": {
                "type": "integer"
              },
              "topic_id": {
                "type": "integer"
              },
              "source_material_id": {
                "type": "integer"
              },
              "statement": {
                "type": "string",
                "minLength": 5
              },
              "question_type": {
                "type": "string",
                "description": "Normalmente multiple_choice."
              },
              "difficulty": {
                "type": "string",
                "enum": [
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "exam",
                  "authored",
                  "adapted"
                ]
              },
              "source_reference": {
                "type": "string"
              },
              "commented_answer": {
                "type": "string"
              },
              "correct_letter": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              "allow_duplicate": {
                "type": "boolean",
                "default": false
              },
              "alternatives": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "letter",
                    "text"
                  ],
                  "properties": {
                    "letter": {
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "checkQuestionDuplicate",
    "title": "Verifica duplicidade",
    "description": "Use antes de criação individual. Batch já verifica.",
    "method": "POST",
    "path": "/questions/duplicate-check",
    "controller": "QuestionReviewApiController",
    "action": "duplicateCheck",
    "read_only": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "ignore_question_id": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "getQuestion",
    "title": "Consulta questão",
    "description": "Retorna a questão completa pelo ID.",
    "method": "GET",
    "path": "/questions/{question}",
    "controller": "QuestionReviewApiController",
    "action": "question",
    "read_only": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "integer"
        }
      },
      "required": [
        "question"
      ]
    }
  }
]
